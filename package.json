{
  "name": "ai-e2e-regression-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Demo TypeScript E2E framework scaffold with Playwright, Azure OpenAI mock, and Jira MCP simulation using OrangeHRM.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:video": "playwright test --video=on",
    "test:e2e:video:fail": "playwright test --video=retain-on-failure",
    "test:unit": "node --require ts-node/register --test agent/jira-mcp-agent.example.test.ts agent/playwright-mcp-generator.example.test.ts agent/orchestrator.example.test.ts jira/jira-writer.example.test.ts healing/self-healing-engine.example.test.ts",
    "demo:heal": "ts-node scripts/healing-demo.ts",
    "show-report": "playwright show-report test-results/html-report",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^26.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
